# Server
PORT=3000
NODE_ENV=development
# Comma-separated trusted app origins. Wildcard is forbidden in production.
CORS_ORIGIN=http://localhost:8081

# Stellar network
STELLAR_NETWORK=testnet
STELLAR_HORIZON_URL=https://horizon-testnet.stellar.org
STELLAR_NETWORK_PASSPHRASE=Test SDF Network ; September 2015
STELLAR_BASE_FEE=100
ALLOW_CUSTOM_HORIZON=false
ALLOW_HTTP_HORIZON=false

# CPINR asset
CPINR_ASSET_CODE=CPINR
CPINR_ASSET_ISSUER=G_CPINR_ISSUER_PUBLIC_KEY

# Key Custody & Signing Provider (Issue #58)
# Options: 'env' (default for local dev/testnet), 'kms' (AWS/GCP Cloud KMS), 'vault' (HashiCorp Vault)
SIGNER_PROVIDER=env

# Backend-only Stellar secrets or KMS URIs.
# In production, use KMS URIs (e.g. kms://arn:aws:kms:region:account:key/...) instead of raw secrets.
SPONSOR_SECRET=S_SPONSOR_SECRET
DISTRIBUTION_SECRET=S_DISTRIBUTION_SECRET
SPONSOR_PUBLIC_KEY=
DISTRIBUTION_PUBLIC_KEY=
MAX_SIGNS_PER_MINUTE=120

# Sponsored account/trustline policy
STARTING_BALANCE=1.5
TRUSTLINE_LIMIT=1000000000
FEE_BUMP_MULTIPLIER=10
TRANSACTION_TIMEOUT_SECONDS=60

# Add Money policy
ENABLE_TESTNET_FAUCET=false
ADD_MONEY_AMOUNT=100
MAX_ADD_MONEY_AMOUNT=1000
ADD_MONEY_COOLDOWN_MS=86400000
MAX_PAYMENT_AMOUNT=100000
IDEMPOTENCY_TTL_MS=600000

# Security and operations
# Required by default outside NODE_ENV=development. Keep enabled for deployed services.
RELAYER_AUTH_REQUIRED=true
RELAYER_ADMIN_TOKEN=
SUPABASE_JWT_SECRET=
SUPABASE_JWT_AUDIENCE=authenticated
SUPABASE_JWT_ISSUER=
SUPABASE_JWKS_URL=
SUPABASE_AUTH_FALLBACK_TO_API=false
JWT_CACHE_TTL_MS=60000
JWKS_CACHE_TTL_MS=600000
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100
LOW_XLM_THRESHOLD=5
LOW_CPINR_THRESHOLD=1000
LOW_BALANCE_CHECK_INTERVAL_MS=300000

# Optional alert webhook. The relayer posts low-balance warnings here.
ALERT_WEBHOOK_URL=

# ---------------------------------------------------------------------------
# Remittance Quotes (Issue #176)
# ---------------------------------------------------------------------------
# Feature-flagged until partner integration exists.
ENABLE_QUOTES_API=false
QUOTE_SIGNATURE_SECRET=
QUOTE_FEE_BPS=175
QUOTE_SPREAD_BPS=0
QUOTE_TTL_SECONDS=60
QUOTE_FX_RATES_JSON={"USD_INR":90.12345678}

# ---------------------------------------------------------------------------
# Ledger Ingest Worker (Issue #44)
# ---------------------------------------------------------------------------
# Ingests on-chain Horizon payment operations into the Supabase transactions table
# and reconciles optimistic client-submitted transactions.
LEDGER_INGEST_ENABLED=true
INGEST_POLL_INTERVAL_MS=5000
INGEST_PENDING_TIMEOUT_MS=300000
INGEST_START_CURSOR=
