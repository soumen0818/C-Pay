{
  "name": "frontend",
  "version": "1.0.0",
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "test": "jest",
    "typecheck": "tsc --noEmit",
    "build:android:production-apk": "npx eas-cli build --platform android --profile production",
    "build:ios:production": "npx eas-cli build --platform ios --profile production",
    "build:production:all": "npx eas-cli build --platform all --profile production"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.3",
    "@noble/ciphers": "^1.3.0",
    "@noble/hashes": "^1.3.2",
    "@react-native-async-storage/async-storage": "^2.2.0",
    "@react-navigation/bottom-tabs": "^7.9.0",
    "@react-navigation/native": "^7.1.26",
    "@react-navigation/stack": "^7.6.13",
    "@stellar/stellar-base": "^15.0.0",
    "@stellar/stellar-sdk": "^15.0.1",
    "@supabase/supabase-js": "^2.89.0",
    "buffer": "^6.0.3",
    "eventemitter3": "^5.0.1",
    "expo": "~54.0.37",
    "expo-camera": "~17.0.10",
    "expo-clipboard": "~8.0.8",
    "expo-constants": "~18.0.14",
    "expo-crypto": "~15.0.9",
    "expo-file-system": "~19.0.24",
    "expo-font": "~14.0.12",
    "expo-image-picker": "~17.0.11",
    "expo-linear-gradient": "^15.0.8",
    "expo-local-authentication": "~17.0.9",
    "expo-media-library": "~18.2.1",
    "expo-secure-store": "~15.0.8",
    "expo-sharing": "^14.0.8",
    "expo-status-bar": "~3.0.9",
    "react": "19.1.0",
    "react-native": "0.81.5",
    "react-native-device-info": "^15.0.1",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-get-random-values": "~1.11.0",
    "react-native-qrcode-svg": "^6.3.21",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-svg": "15.12.1",
    "react-native-view-shot": "^4.0.3"
  },
  "devDependencies": {
    "@babel/core": "^7.27.4",
    "@types/jest": "^29.5.14",
    "@types/react": "~19.1.0",
    "babel-preset-expo": "~54.0.10",
    "jest": "^29.7.0",
    "typescript": "^5.9.3"
  },
  "jest": {
    "testEnvironment": "node",
    "testMatch": [
      "**/__tests__/**/*.test.ts",
      "**/__tests__/**/*.test.tsx",
      "**/__tests__/**/*.test.js"
    ],
    "transform": {
      "^.+\\.[jt]sx?$": "babel-jest"
    },
    "transformIgnorePatterns": [
      "node_modules/(?!(expo|expo-modules-core|@expo|@stellar|react-native|@react-native|@unimodules|unimodules)/)"
    ],
    "moduleNameMapper": {
      "\\.(png|jpe?g|gif|webp)$": "<rootDir>/src/__mocks__/assetMock.js",
      "^@react-native-async-storage/async-storage$": "<rootDir>/src/__mocks__/asyncStorage.ts",
      "^expo-secure-store$": "<rootDir>/src/__mocks__/expoSecureStore.ts",
      "^expo-crypto$": "<rootDir>/src/__mocks__/expoCrypto.ts",
      "^react-native$": "<rootDir>/src/__mocks__/reactNative.ts",
      "^expo$": "<rootDir>/src/__mocks__/expo.ts",
      "^expo-constants$": "<rootDir>/src/__mocks__/expoConstants.ts",
      "^expo-linear-gradient$": "<rootDir>/src/__mocks__/expoLinearGradient.ts",
      "^@expo/vector-icons$": "<rootDir>/src/__mocks__/expoVectorIcons.ts",
      "^@expo/vector-icons/(.*)$": "<rootDir>/src/__mocks__/expoVectorIcons.ts",
      "^@react-navigation/native$": "<rootDir>/src/__mocks__/reactNavigationNative.ts",
      "^expo-sharing$": "<rootDir>/src/__mocks__/expoSharing.ts",
      "^react-native-view-shot$": "<rootDir>/src/__mocks__/reactNativeViewShot.ts",
      "^expo-clipboard$": "<rootDir>/src/__mocks__/expoClipboard.ts",
      "^expo-local-authentication$": "<rootDir>/src/__mocks__/expoLocalAuthentication.ts",
      "^expo-image-picker$": "<rootDir>/src/__mocks__/expoImagePicker.ts",
      "^expo-media-library$": "<rootDir>/src/__mocks__/expoMediaLibrary.ts",
      "^react-native-safe-area-context$": "<rootDir>/src/__mocks__/reactNativeSafeAreaContext.ts",
      "^react-native-qrcode-svg$": "<rootDir>/src/__mocks__/reactNativeQrCodeSvg.ts",
      "^react-native-svg$": "<rootDir>/src/__mocks__/reactNativeSvg.ts",
      "^\\.\\./services/supabase$": "<rootDir>/src/__mocks__/supabase.ts",
      "^\\.\\./\\.\\./services/supabase$": "<rootDir>/src/__mocks__/supabase.ts",
      "^(.*)/services/supabase$": "<rootDir>/src/__mocks__/supabase.ts",
      "^\\./supabase$": "<rootDir>/src/__mocks__/supabase.ts"
    }
  },
  "private": true,
  "overrides": {
    "axios": "1.15.2"
  }
}
